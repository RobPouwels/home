# Publieke HTTPS-URL van de gehoste app, zonder slash aan het einde
APP_URL=https://jouw-thuis-app.onrender.com
# Willekeurige lange wachtzin voor jouw persoonlijke dashboard (minimaal 20 tekens)
ADMIN_PASSWORD=vervang-door-een-lange-unieke-wachtzin
# 32 bytes als 64 hex-tekens; genereer met: openssl rand -hex 32
ENCRYPTION_KEY=VUL_HIER_64_HEX_TEKENS_IN
# Postgres-connectionstring van Supabase/Neon. Gebruik SSL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# In te vullen nadat je OAuth-client bij Athom hebt aangemaakt
HOMEY_CLIENT_ID=
HOMEY_CLIENT_SECRET=
# Optioneel: true schakelt de duidelijk gemarkeerde demo in
DEMO_ENABLED=true
NODE_ENV=production
